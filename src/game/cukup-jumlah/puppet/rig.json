  "draw_order": [
    "leg x2",
    "foot x2",
    "lower:sarong",
    "torso",
    "outfit",
    "lower:songket_samping",
    "head",
    "headwear",
    "upper_arm x2",
    "sleeve_upper x2",
    "forearm_hand x2",
    "sleeve_forearm x2"
  ],
  "joints": {
    "torso.neck": "head.neck",
    "torso.shoulder_L/R": "upper_arm.shoulder",
    "upper_arm.elbow": "forearm_hand.elbow",
    "torso.hip_L/R": "leg.hip (also lower.waist centred between hips, offset up ~40px)",
    "leg.ankle": "foot.ankle",
    "head.hat_brim": "headwear.brim",
    "head.face_center": "tudung.face_hole_center"
  },
  "notes": "Left-side limbs: mirror horizontally (x -> width-1-x). Outfits share the base torso pin layout and replace/overlay the torso.",
  "skin": {
    "method": "HSV mask recolour: pixels with hue 12-45deg, sat 0.22-0.78, value>0.30, excluding a circle of radius pin_radius around every pin (brass), get RGB multiplied by target/source_mean_skin. Pre-baked results in parts/base_tones/<tone>/. Outfits and sleeves are NOT tinted (their gold/orange batik falls in the same hue range); their small skin neck tab is hidden under the head.",
    "tones": {
      "tone_1": [
        246,
        218,
        186
      ],
      "tone_2": [
        236,
        196,
        154
      ],
      "tone_3": [
        214,
        164,
        114
      ],
      "tone_4": [
        196,
        136,
        84
      ],
      "tone_5": [
        178,
        118,
        71
      ],
      "tone_6": [
        160,
        100,
        58
      ],
      "tone_7": [
        118,
        70,
        40
      ],
      "tone_8": [
        86,
        52,
        32
      ]
    },
    "base_tones_dir": "parts/base_tones/<tone>/<part>.webp"
  },
  "placement": {
    "headwear_brim_dy": {
      "songkok": 15,
      "ketayap": 15,
      "turban": 15,
      "baseball_cap": 0,
      "baseball_cap_red": 0,
      "baseball_cap_mustard": 0
    },
    "headwear_note": "place headwear.brim at head.hat_brim + (0, dy)",
    "tudung": "place tudung.face_hole_center at head.face_center",
    "lower_waist_dy_from_hips": {
      "songket_samping": -110,
      "sarong": -60
    },
    "lower_note": "waist pin x = torso centre, y = torso hip pin y + dy",
    "sleeve_upper": "sleeves/<outfit>_upper.shoulder -> torso.shoulder_*",
    "sleeve_forearm": "sleeves/<outfit>_forearm.elbow -> upper_arm.elbow (same point as forearm_hand.elbow)",
    "mirror": "right-side limbs, sleeves and the right foot are mirrored horizontally"
  },
  "sleeves": {
